FROM node:24.0.0-alpine

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

WORKDIR /app

# Just copy the package files first to take advantage of the Docker layer cache.
COPY package.json pnpm-lock.yaml ./

RUN pnpm install

# Copy the entire source code (volume mount will be overridden during development).
COPY . .

EXPOSE 3000

# Watch mode — automatically reloads when code changes
CMD ["pnpm", "start:dev"]
